\begin{lstlisting}
# Plot
plt.figure(figsize=(10, 5))
plt.plot(t, x_fs, label=f'Fourier Series (N={N})', linewidth=2)

plt.title('Fourier Series Approximation')
plt.xlabel('Time')
plt.ylabel('Amplitude')
plt.legend()
plt.grid()

# Save figure
plt.savefig('fourier_series.png', dpi=300)

plt.show()
